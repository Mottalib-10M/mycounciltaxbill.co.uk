---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/council-tax-calculator/" title="Council tax calculator 2026/27" width="100%" height="980" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the council tax calculator 2026/27 on your website" description="Put the 2026/27 council tax bill calculator on your website for free: one iframe, 350 councils in England, Wales and Scotland, discounts and premiums, no sign-up and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the council tax calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a letting agent's listings, a student union's housing page or a relocation guide: visitors pick a council and a band and see the 2026/27 bill, with the single person discount, student exemption and second home premium.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible and use it as it is, without warranty. When the March tables for the next year are published, the embedded calculator updates itself.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/council-tax-calculator/" title="Council tax calculator 2026/27" width="100%" height="980" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
